# Copy to .env and adjust as needed. Compose already sets Docker-safe defaults.

# --- LLM (Ollama, OpenAI-compatible) ----------------------------------------
LLAMA_BASE_URL=http://localhost:11434/v1
LLAMA_API_KEY=not-needed
LLAMA_MODEL=qwen2.5:3b
# Judge model for RAGAS evaluation (larger = more reliable). Defaults to LLAMA_MODEL.
EVAL_LLM_MODEL=qwen2.5:3b

# --- Embeddings / chunking --------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNKING_STRATEGY=semantic   # semantic | recursive

# --- Retrieval / reranking --------------------------------------------------
RETRIEVER_K=4
RETRIEVE_TOP_N=12
BM25_WEIGHT=0.5
DENSE_WEIGHT=0.5
RERANK_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Voice (Phase 3) --------------------------------------------------------
STT_MODEL_SIZE=base          # tiny | base | small | medium | large-v3
TTS_VOICE=en_US-lessac-medium

# --- Agent tools (Phase 4) --------------------------------------------------
# Optional: web search is auto-disabled when this is empty.
TAVILY_API_KEY=

# --- LangSmith tracing (optional) -------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=docrag
